# Public
NEXT_PUBLIC_SERVER_URL="http://localhost:3000" # Base URL of the server(Here same)

# Database
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB]" # Url of your database
# POSTGRES VARS FOR DOCKER
POSTGRES_USER="[USER]"
POSTGRES_PASSWORD="[PASSWORD]"
POSTGRES_PORT=[PORT]
POSTGRES_DB="[DB]"

